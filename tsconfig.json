{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.js",
    "scripts/**/*.mjs",
    "tests/**/*.js",
    "tests/**/*.mjs"
  ]
}
